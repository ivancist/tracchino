{
  "name": "Tracchino",
  "dockerComposeFile": "../compose.yaml",
  "service": "dev",
  "workspaceFolder": "/app",
  "remoteUser": "node",
  "shutdownAction": "none",
  "postCreateCommand": "npm ci && npx playwright install chromium",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "ms-playwright.playwright",
        "vitest.explorer"
      ]
    }
  }
}
