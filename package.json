{
  "name": "tracchino",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && rm -f dist/tracchino/.dev.vars && ! grep -qE \"DEV_AUTH_BYPASS|ALLOWED_EMAIL\" dist/tracchino/wrangler.json && scripts/check-secrets.sh dist",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply tracchino --local",
    "db:migrate:remote": "wrangler d1 migrations apply tracchino --remote"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261001.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
