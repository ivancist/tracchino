{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tracchino",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-15",
  // Served on *.workers.dev behind Cloudflare Access; no alternative preview URLs
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // ACCESS_TEAM_DOMAIN, ACCESS_AUD, ALLOWED_EMAIL and GEMINI_API_KEY are secrets (public repo):
  // locally in .dev.vars, in production via `wrangler secret put` (see docs/SETUP.md)
  "vars": {
    // Receipt scan model (free tier); compare alternatives with the receipt-eval skill
    "GEMINI_MODEL": "gemini-3.5-flash-lite"
  },
  // Private bucket for receipt photos: no public access, read only through /api/receipts/:id/photo
  "r2_buckets": [
    {
      "binding": "RECEIPT_PHOTOS",
      "bucket_name": "tracchino-receipts",
      "jurisdiction": "eu"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tracchino",
      "database_id": "bb2546db-b88b-4cbd-958c-a2b2fd4d9f0c",
      "migrations_dir": "db/migrations"
    }
  ]
}
